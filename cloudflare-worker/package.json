{
  "name": "enjoy-school-notices-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "check": "wrangler deploy --config wrangler.toml --dry-run",
    "dev:biseo": "wrangler dev --config wrangler-biseo.toml",
    "deploy:biseo": "wrangler deploy --config wrangler-biseo.toml",
    "check:biseo": "wrangler deploy --config wrangler-biseo.toml --dry-run",
    "dev:everytime": "wrangler dev --config wrangler-everytime.toml",
    "deploy:everytime": "wrangler deploy --config wrangler-everytime.toml",
    "check:everytime": "wrangler deploy --config wrangler-everytime.toml --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.103.0"
  }
}
