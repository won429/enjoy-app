    "dev:prediction": "wrangler dev --config wrangler-prediction.toml",
    "check:prediction": "wrangler deploy --config wrangler-prediction.toml --dry-run",
    "deploy:prediction": "wrangler deploy --config wrangler-prediction.toml",
    "dev": "wrangler dev --config wrangler.toml",
