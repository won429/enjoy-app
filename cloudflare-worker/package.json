    "check:everytime": "wrangler deploy --config wrangler-everytime.toml --dry-run",
    "dev:cube": "wrangler dev --config wrangler-cube.toml",
    "check:cube": "wrangler deploy --config wrangler-cube.toml --dry-run",
    "deploy:cube": "wrangler deploy --config wrangler-cube.toml",
    "dev:investment": "wrangler dev --config wrangler-investment.toml",
