+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const source = '../cloudflare-worker/veron-google-stream.js';
+function fragmented(frames, terminal = true) {
+    const bytes = new TextEncoder().encode(frames.map(frame => 'data: ' + JSON.stringify(frame)).join('\r\n\r\n') + (terminal ? '\r\n\r\n' : ''));
+    let offset = 0;
+    return new Response(new ReadableStream({ pull(controller) {
+        if (offset >= bytes.length) return controller.close();
+        controller.enqueue(bytes.slice(offset, offset + 1)); offset++;
+    } }), { headers: { 'Content-Type': 'text/event-stream' } });
+}
